; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="vital pixel"
run/main_scene="res://src/features/menu/screens/intro_cinematic.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.30692276, 0.30692267, 0.30692264, 1)

[autoload]

Global="*res://src/core/managers/global.gd"
SaveManager="*res://src/core/managers/save_manager.gd"
EventBus="*res://src/core/managers/event_bus.gd"
SceneManager="*res://src/core/managers/scene_manager.gd"
DialogBox="*res://src/features/menu/features/dialog/dialog_box.tscn"
AiDialogBox="*res://src/features/menu/features/dialog/ai_dialog_box.tscn"
AiClient="*res://src/core/infrastructure/ai/ai_client.gd"
QuestManager="*res://src/core/managers/quest_manager.gd"
MiniGameManager="*res://src/core/managers/mini_game_manager.gd"
ScoreManager="*res://src/core/managers/score_manager.gd"
JournalManager="*res://src/core/managers/journal_manager.gd"
PhoneHud="*res://src/features/menu/features/phone/phone_hud.tscn"
Supabase="*res://src/core/infrastructure/supabase/supabase.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/zylann.editor_debugger/plugin.cfg")

