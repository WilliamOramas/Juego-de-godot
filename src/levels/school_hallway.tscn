[node name="EstudiantePasilloNervioso" parent="." unique_id=671978575 instance=ExtResource("5_npc")]
position = Vector2(250, 150)
sprite_texture = ExtResource("6_np1")
npc_name = "Luis"
dialog_lines = Array[String](["¡El examen de matemáticas es hoy! Estoy muy nervioso.", "No he dormido nada estudiando fórmulas y todavía no me sé ninguna.", "Ojalá el profesor ponga algo fácil... como sumas."])
dialog_lines_repeat = Array[String](["Todavía no empieza el examen y ya siento que voy a reprobar.", "Mis manos no dejan de temblar, hermano."])
quest_to_start = ExtResource("12_qintro")
wander_radius = 40.0

[node name="EstudiantePasilloEnfermo" parent="." unique_id=622006352 instance=ExtResource("5_npc")]
position = Vector2(612, 149)
sprite_texture = ExtResource("15_npc_sprite")
sprite_frame = 15
sprite_modulate = Color(0.85, 0.9, 1, 1)
npc_name = "Pedro"
dialog_lines = Array[String](["Me duele el estómago... Creo que iré a la enfermería.", "El desayuno de la cafetería no me cayó bien, qué asco.", "Ojalá la enfermera me dé algo para el dolor."])
dialog_lines_repeat = Array[String](["Todavía me duele... mejor me voy a casa.", "Ya hablé con el enfermero, me dijo que descanse."])
wander_radius = 40.0

[node name="EstudiantePasilloTranquilo" parent="." unique_id=282534089 instance=ExtResource("5_npc")]
position = Vector2(280, 567)
sprite_texture = ExtResource("6_np1")
npc_name = "Jorge"
dialog_lines = Array[String](["Uff, qué día tan pesado. Tres exámenes en una semana es una locura.", "El de matemáticas me fue mal, pero el de historia creo que lo salvé.", "Ojalá el profesor de inglés haya visto mi tarea a tiempo."])
dialog_lines_repeat = Array[String](["Sigo estudiando para los exámenes, no me queda de otra.", "Al menos ya casi es viernes, eso es lo único que me anima."])
dialog_lines_blocked = Array[String](["Eh, todavía no he terminado de hablar con los demás. Primero ve a ver cómo están Luis y Pedro, ¿sí?"])
quest_to_start = ExtResource("13_qexplore")
wander_radius = 40.0

[node name="EstudiantePasilloPreocupada" parent="." unique_id=899978710 instance=ExtResource("5_npc")]
position = Vector2(477, 524)
sprite_texture = ExtResource("14_np3")
npc_name = "María"
dialog_lines = Array[String](["¿Has visto a Luis? Está histérico con el examen de matemáticas.", "Y Pedro fue a la enfermería con dolor de estómago... espero que no sea grave.", "Menos mal que yo entregué todo a tiempo, así que ando tranquila."])
dialog_lines_repeat = Array[String](["Sigo viendo a Luis repasar fórmulas en voz alta, pobrecito.", "El pasillo está más alborotado de lo normal hoy."])
wander_radius = 40.0

