><column index="1" value="61"/><column index="2" value="69"/><column index="3" value="81"/><column index="4" value="156"/><column index="5" value="83"/><column index="6" value="62"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">
CREATE TRIGGER Validar_Puntaje_Negativo
BEFORE UPDATE OF puntaje_final ON sesiones
FOR EACH ROW
WHEN NEW.puntaje_final &lt; 0
BEGIN
    SELECT RAISE(ABORT, 'Error de Juego: El puntaje final no puede ser negativo.');
END;</sql><sql name="SQL 2">
INSERT OR IGNORE INTO usuarios (id_usuario, nombre) VALUES (1, 'Estudiante Prueba');


INSERT OR IGNORE INTO escenarios (id_escenario, nombre, nivel_dificultad, tiempo_base_seg) 
VALUES (1, 'RCP Básico', 1, 60);


INSERT OR IGNORE INTO sesiones (id_sesion, id_usuario, id_escenario, puntaje_final) 
VALUES (1, 1, 1, 100);</sql><sql name="SQL 3">
UPDATE sesiones SET puntaje_final = 50 WHERE id_sesion = 1;</sql><sql name="SQL 4">CREATE TRIGGER Validar_Puntaje_Negativo_Insert
BEFORE INSERT ON sesiones
FOR EACH ROW
WHEN NEW.puntaje_final &lt; 0
BEGIN
    SELECT RAISE(ABORT, 'No se puede insertar una sesión con puntaje negativo');
END;</sql><sql name="SQL 5">CREATE TRIGGER actualizar_puntaje_final
AFTER INSERT ON telemetria_eventos
FOR EACH ROW
WHEN NEW.es_correcto = 0
BEGIN
    UPDATE sesiones 
    SET puntaje_final = COALESCE(puntaje_final, 100) - 10
    WHERE id_sesion = NEW.id_sesion;
END;</sql><sql name="SQL 6">CREATE TRIGGER validar_eventos_al_cerrar
BEFORE UPDATE ON sesiones
FOR EACH ROW
WHEN NEW.resultado IS NOT NULL AND (
    SELECT COUNT(*) FROM telemetria_eventos WHERE id_sesion = NEW.id_sesion
) = 0
BEGIN
    SELECT RAISE(ABORT, 'No se puede finalizar sesión sin eventos de telemetría');
END;</sql><sql name="SQL 7">INSERT INTO sesiones (id_usuario, id_escenario, puntaje_final)
VALUES (1, 1, 100);</sql><sql name="SQL 8">INSERT INTO telemetria_eventos (id_sesion, accion_realizada, es_correcto, tiempo_seg)
VALUES (2, 'Verificar pulso', 1, 5.0);</sql><sql name="SQL 9">UPDATE sesiones SET resultado = 'Salvado' WHERE id_sesion = 2;</sql><sql name="SQL 10">SELECT puntaje_final FROM sesiones WHERE id_sesion = 2;</sql><sql name="SQL 11">INSERT INTO telemetria_eventos (id_sesion, accion_realizada, es_correcto, tiempo_seg)
VALUES (2, 'Aplicar agua en quemadura', 0, 12.0);</sql><sql name="SQL 12">SELECT puntaje_final FROM sesiones WHERE id_sesion = 2;</sql><sql name="SQL 13*">
