npc_name = "Antonio"
dialog_lines = Array[String](["Hola, ¿viniste a estudiar? Este salón está más tranquilo.", "El profe de ciencias dejó una tarea bien difícil, ¿ya la hiciste?", "Si quieres te presto mis apuntes, tengo todo el temario."])
