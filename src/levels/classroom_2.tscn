dialog_lines = Array[String](["Antonio es el más aplicado de la clase, pero yo también vengo a estudiar aquí.", "Este salón es el único lugar tranquilo para concentrarse.", "Si necesitas apuntes, Antonio tiene los mejores. Bueno, y yo también."])
